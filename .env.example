BOLD_IDENTITY_KEY=
BOLD_SECRET_KEY=

# Required for the new persistent-order checkout. Keep disabled until Preview is configured.
BOLD_CONFIRMATION_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Upstash integration names; used when the corresponding UPSTASH value is absent.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Required: preview-pedidos in Preview; production-pedidos in Production. No shared default.
BOLD_STORAGE_NAMESPACE=

# Resend: verify the sender domain before enabling. Do not use a Gmail address as sender.
KAEMENTO_EMAIL_ENABLED=false
RESEND_API_KEY=
KAEMENTO_EMAIL_FROM=
KAEMENTO_SALES_EMAIL=kaemento@gmail.com,admin.kaemento@gmail.com
# Independent random server-side secret (at least 32 characters) for authenticated email retries.
KAEMENTO_EMAIL_RETRY_SECRET=
